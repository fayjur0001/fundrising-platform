# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:691530@localhost:5432/fundraising_db"

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_NEW_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_NEW_REFRESH_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── URLs ──────────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# ── Email (Nodemailer) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
FROM_EMAIL=your_gmail@gmail.com

# ── SSLCommerz ────────────────────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASS=test
SSLCOMMERZ_IS_LIVE=false

# ── File Upload ───────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ── Google OAuth (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here